{
  "id": "meadow-breeze-5",
  "voiceId": "it-diego",
  "edgeVoice": "it-IT-DiegoNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 372,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 3.216
    },
    {
      "index": 1,
      "text": "Prendi una posizione comoda, oppure sdraiati se ti sembra meglio.",
      "file": "c001.ogg",
      "durationSec": 8.616
    },
    {
      "index": 2,
      "text": "Lascia riposare le mani.",
      "file": "c002.ogg",
      "durationSec": 4.32
    },
    {
      "index": 3,
      "text": "Lascia che gli occhi si chiudano, o ammorbidisci lo sguardo.",
      "file": "c003.ogg",
      "durationSec": 7.8
    },
    {
      "index": 4,
      "text": "Nota il peso del tuo corpo che viene sostenuto.",
      "file": "c004.ogg",
      "durationSec": 6.24
    },
    {
      "index": 5,
      "text": "Fai un respiro lento attraverso il naso.",
      "file": "c005.ogg",
      "durationSec": 5.616
    },
    {
      "index": 6,
      "text": "E un respiro più lungo e facile attraverso la bocca.",
      "file": "c006.ogg",
      "durationSec": 6.72
    },
    {
      "index": 7,
      "text": "Ancora una volta. Inhala dolcemente.",
      "file": "c007.ogg",
      "durationSec": 7.536
    },
    {
      "index": 8,
      "text": "Esala delicatamente.",
      "file": "c008.ogg",
      "durationSec": 4.152
    },
    {
      "index": 9,
      "text": "Se i pensieri vagano, va bene. Ritorna al respiro.",
      "file": "c009.ogg",
      "durationSec": 9.312
    },
    {
      "index": 10,
      "text": "Immagina un vasto prato montano nel tardo mattino.",
      "file": "c010.ogg",
      "durationSec": 6.96
    },
    {
      "index": 11,
      "text": "L'erba alta ondeggia in morbide ondate.",
      "file": "c011.ogg",
      "durationSec": 5.472
    },
    {
      "index": 12,
      "text": "Il sole è caldo senza essere acuto.",
      "file": "c012.ogg",
      "durationSec": 5.472
    },
    {
      "index": 13,
      "text": "Senti il calore sulla sommità della testa, gentile e costante.",
      "file": "c013.ogg",
      "durationSec": 8.256
    },
    {
      "index": 14,
      "text": "Una brezza fresca attraversa l'erba e arriva al tuo viso.",
      "file": "c014.ogg",
      "durationSec": 7.104
    },
    {
      "index": 15,
      "text": "Ha l'odore di fiori selvatici e terra asciutta al sole.",
      "file": "c015.ogg",
      "durationSec": 7.008
    },
    {
      "index": 16,
      "text": "Cammini lentamente, con le dita che sfiorano le spighe di semi.",
      "file": "c016.ogg",
      "durationSec": 8.136
    },
    {
      "index": 17,
      "text": "Pizzico delicato. Suono morbido.",
      "file": "c017.ogg",
      "durationSec": 7.296
    },
    {
      "index": 18,
      "text": "Farfalle si alzano e si posano di nuovo, senza fretta.",
      "file": "c018.ogg",
      "durationSec": 7.728
    },
    {
      "index": 19,
      "text": "Trovi un posto per sdraiarti sull'erba.",
      "file": "c019.ogg",
      "durationSec": 5.592
    },
    {
      "index": 20,
      "text": "La terra sostiene tutta la tua lunghezza.",
      "file": "c020.ogg",
      "durationSec": 6.024
    },
    {
      "index": 21,
      "text": "Calore lungo il tuo corpo anteriore. Ombra fredda del terreno ai tuoi lati.",
      "file": "c021.ogg",
      "durationSec": 10.56
    },
    {
      "index": 22,
      "text": "La brezza arriva e se ne va come una marea amichevole.",
      "file": "c022.ogg",
      "durationSec": 6.672
    },
    {
      "index": 23,
      "text": "Inhala freschezza. Esala nel cielo aperto.",
      "file": "c023.ogg",
      "durationSec": 7.968
    },
    {
      "index": 24,
      "text": "Una nuvola scorre davanti al sole per un momento.",
      "file": "c024.ogg",
      "durationSec": 6.36
    },
    {
      "index": 25,
      "text": "Freddo. Poi il calore ritorna sul tuo viso.",
      "file": "c025.ogg",
      "durationSec": 8.088
    },
    {
      "index": 26,
      "text": "Notate quanto grande sembra il silenzio.",
      "file": "c026.ogg",
      "durationSec": 5.856
    },
    {
      "index": 27,
      "text": "Quanto piccola sembra qualsiasi preoccupazione in questo vasto campo.",
      "file": "c027.ogg",
      "durationSec": 8.424
    },
    {
      "index": 28,
      "text": "Le tue mani riposano nell'erba. Piccoli steli premono dolcemente.",
      "file": "c028.ogg",
      "durationSec": 9.864
    },
    {
      "index": 29,
      "text": "Rimani con il calore del sole sui tuoi occhi chiusi.",
      "file": "c029.ogg",
      "durationSec": 6.912
    },
    {
      "index": 30,
      "text": "Rimani con la morbida pressione dell'erba contro le tue braccia.",
      "file": "c030.ogg",
      "durationSec": 7.848
    },
    {
      "index": 31,
      "text": "Ti è permesso essere così immobile.",
      "file": "c031.ogg",
      "durationSec": 5.016
    },
    {
      "index": 32,
      "text": "Lascia che il prato respiri per te per qualche ciclo in più.",
      "file": "c032.ogg",
      "durationSec": 7.032
    },
    {
      "index": 33,
      "text": "Porta la tua attenzione dalla calda corona della testa",
      "file": "c033.ogg",
      "durationSec": 6.84
    },
    {
      "index": 34,
      "text": "giù attraverso un viso morbido, una gola morbida,",
      "file": "c034.ogg",
      "durationSec": 7.128
    },
    {
      "index": 35,
      "text": "nel petto che si alza facilmente sotto il cielo aperto.",
      "file": "c035.ogg",
      "durationSec": 6.744
    },
    {
      "index": 36,
      "text": "La brezza trova l'interno dei tuoi polsi.",
      "file": "c036.ogg",
      "durationSec": 5.952
    },
    {
      "index": 37,
      "text": "Freddo. Vivo. Amichevole.",
      "file": "c037.ogg",
      "durationSec": 8.784
    },
    {
      "index": 38,
      "text": "Da qualche parte le api lavorano senza fretta.",
      "file": "c038.ogg",
      "durationSec": 6.36
    },
    {
      "index": 39,
      "text": "Il loro ronzio è un altro tipo di silenzio.",
      "file": "c039.ogg",
      "durationSec": 6.672
    },
    {
      "index": 40,
      "text": "Rimani finché calore e freschezza sembrano un unico tessuto.",
      "file": "c040.ogg",
      "durationSec": 7.536
    },
    {
      "index": 41,
      "text": "Ora riposa solo nel respiro per un po'.",
      "file": "c041.ogg",
      "durationSec": 5.52
    },
    {
      "index": 42,
      "text": "Inhala lentamente.",
      "file": "c042.ogg",
      "durationSec": 3.888
    },
    {
      "index": 43,
      "text": "Esala lentamente.",
      "file": "c043.ogg",
      "durationSec": 3.864
    },
    {
      "index": 44,
      "text": "Inhala.",
      "file": "c044.ogg",
      "durationSec": 2.928
    },
    {
      "index": 45,
      "text": "Esala.",
      "file": "c045.ogg",
      "durationSec": 2.928
    },
    {
      "index": 46,
      "text": "Senti il calore ovunque il corpo sia caldo.",
      "file": "c046.ogg",
      "durationSec": 6.096
    },
    {
      "index": 47,
      "text": "Senti la freschezza ovunque l'aria sia fresca.",
      "file": "c047.ogg",
      "durationSec": 6.312
    },
    {
      "index": 48,
      "text": "Inhala.",
      "file": "c048.ogg",
      "durationSec": 2.928
    },
    {
      "index": 49,
      "text": "Esala.",
      "file": "c049.ogg",
      "durationSec": 2.928
    },
    {
      "index": 50,
      "text": "Nessun posto dove andare. Niente da sistemare.",
      "file": "c050.ogg",
      "durationSec": 8.352
    },
    {
      "index": 51,
      "text": "Inhala.",
      "file": "c051.ogg",
      "durationSec": 2.928
    },
    {
      "index": 52,
      "text": "Esala.",
      "file": "c052.ogg",
      "durationSec": 2.928
    },
    {
      "index": 53,
      "text": "Riposa qui per qualche respiro tranquillo.",
      "file": "c053.ogg",
      "durationSec": 5.688
    },
    {
      "index": 54,
      "text": "Sappi che puoi tornare in questo posto in qualsiasi momento.",
      "file": "c054.ogg",
      "durationSec": 7.296
    },
    {
      "index": 55,
      "text": "Quando sei pronto, approfondisci il respiro.",
      "file": "c055.ogg",
      "durationSec": 6.672
    },
    {
      "index": 56,
      "text": "Muovi le dita delle mani e dei piedi.",
      "file": "c056.ogg",
      "durationSec": 5.424
    },
    {
      "index": 57,
      "text": "Apri gli occhi dolcemente.",
      "file": "c057.ogg",
      "durationSec": 4.464
    },
    {
      "index": 58,
      "text": "Porta con te un po' di questa pace.",
      "file": "c058.ogg",
      "durationSec": 5.28
    }
  ]
}
