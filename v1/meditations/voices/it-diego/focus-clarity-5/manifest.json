{
  "id": "focus-clarity-5",
  "voiceId": "it-diego",
  "edgeVoice": "it-IT-DiegoNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 175,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 3.216
    },
    {
      "index": 1,
      "text": "Trova una posizione comoda, o sdraiati se ti sembra meglio.",
      "file": "c001.ogg",
      "durationSec": 8.28
    },
    {
      "index": 2,
      "text": "Lascia che le mani riposino.",
      "file": "c002.ogg",
      "durationSec": 4.68
    },
    {
      "index": 3,
      "text": "Rilassa gli occhi, o chiudili.",
      "file": "c003.ogg",
      "durationSec": 5.544
    },
    {
      "index": 4,
      "text": "Fai un respiro lento e profondo.",
      "file": "c004.ogg",
      "durationSec": 5.232
    },
    {
      "index": 5,
      "text": "E un respiro più lungo in uscita.",
      "file": "c005.ogg",
      "durationSec": 4.968
    },
    {
      "index": 6,
      "text": "Scegli un punto di riferimento. Il respiro alle narici, o l'espansione dell'addome.",
      "file": "c006.ogg",
      "durationSec": 11.832
    },
    {
      "index": 7,
      "text": "Mantieni l'attenzione lì.",
      "file": "c007.ogg",
      "durationSec": 4.536
    },
    {
      "index": 8,
      "text": "[pausa:23]",
      "file": "c008.ogg",
      "durationSec": 4.344
    },
    {
      "index": 9,
      "text": "Quando la mente divaga, nota dove è andata.",
      "file": "c009.ogg",
      "durationSec": 6.312
    },
    {
      "index": 10,
      "text": "Poi torna indietro. Gentilmente. Con chiarezza.",
      "file": "c010.ogg",
      "durationSec": 10.392
    },
    {
      "index": 11,
      "text": "[pausa:29]",
      "file": "c011.ogg",
      "durationSec": 4.488
    },
    {
      "index": 12,
      "text": "Il ritorno è l'allenamento.",
      "file": "c012.ogg",
      "durationSec": 4.656
    },
    {
      "index": 13,
      "text": "Inhala. Resta.",
      "file": "c013.ogg",
      "durationSec": 5.616
    },
    {
      "index": 14,
      "text": "Esala. Resta.",
      "file": "c014.ogg",
      "durationSec": 5.592
    },
    {
      "index": 15,
      "text": "[pausa:34]",
      "file": "c015.ogg",
      "durationSec": 4.944
    },
    {
      "index": 16,
      "text": "Se ti aiuta, conta i respiri fino a cinque, poi ricomincia.",
      "file": "c016.ogg",
      "durationSec": 8.76
    },
    {
      "index": 17,
      "text": "Uno.",
      "file": "c017.ogg",
      "durationSec": 2.688
    },
    {
      "index": 18,
      "text": "[pausa:17]",
      "file": "c018.ogg",
      "durationSec": 4.872
    },
    {
      "index": 19,
      "text": "Due.",
      "file": "c019.ogg",
      "durationSec": 2.616
    },
    {
      "index": 20,
      "text": "[pausa:17]",
      "file": "c020.ogg",
      "durationSec": 4.872
    },
    {
      "index": 21,
      "text": "Tre.",
      "file": "c021.ogg",
      "durationSec": 2.424
    },
    {
      "index": 22,
      "text": "[pausa:17]",
      "file": "c022.ogg",
      "durationSec": 4.872
    },
    {
      "index": 23,
      "text": "Quattro.",
      "file": "c023.ogg",
      "durationSec": 2.88
    },
    {
      "index": 24,
      "text": "[pausa:17]",
      "file": "c024.ogg",
      "durationSec": 4.872
    },
    {
      "index": 25,
      "text": "Cinque.",
      "file": "c025.ogg",
      "durationSec": 2.856
    },
    {
      "index": 26,
      "text": "[pausa:23]",
      "file": "c026.ogg",
      "durationSec": 4.344
    },
    {
      "index": 27,
      "text": "Lascia andare il conto.",
      "file": "c027.ogg",
      "durationSec": 4.056
    },
    {
      "index": 28,
      "text": "Rimani in attenzione chiara e aperta per un momento.",
      "file": "c028.ogg",
      "durationSec": 6.528
    },
    {
      "index": 29,
      "text": "[pausa:34]",
      "file": "c029.ogg",
      "durationSec": 4.944
    },
    {
      "index": 30,
      "text": "Fai un altro respiro facile.",
      "file": "c030.ogg",
      "durationSec": 4.872
    },
    {
      "index": 31,
      "text": "Muovi le dita.",
      "file": "c031.ogg",
      "durationSec": 3.432
    },
    {
      "index": 32,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c032.ogg",
      "durationSec": 5.64
    },
    {
      "index": 33,
      "text": "Porta con te un po' di questo.",
      "file": "c033.ogg",
      "durationSec": 4.776
    }
  ]
}
