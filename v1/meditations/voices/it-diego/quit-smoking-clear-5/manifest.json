{
  "id": "quit-smoking-clear-5",
  "voiceId": "it-diego",
  "edgeVoice": "it-IT-DiegoNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 260,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 3.216
    },
    {
      "index": 1,
      "text": "Questa è una pratica del respiro chiaro.",
      "file": "c001.ogg",
      "durationSec": 5.544
    },
    {
      "index": 2,
      "text": "Trova una posizione comoda, o sdraiati se ti sembra meglio.",
      "file": "c002.ogg",
      "durationSec": 8.28
    },
    {
      "index": 3,
      "text": "Lascia riposare le mani.",
      "file": "c003.ogg",
      "durationSec": 4.32
    },
    {
      "index": 4,
      "text": "Ammorbidisci gli occhi, o chiudili.",
      "file": "c004.ogg",
      "durationSec": 5.88
    },
    {
      "index": 5,
      "text": "Fai un respiro lento attraverso il naso.",
      "file": "c005.ogg",
      "durationSec": 5.616
    },
    {
      "index": 6,
      "text": "E un respiro più lungo fuori.",
      "file": "c006.ogg",
      "durationSec": 4.752
    },
    {
      "index": 7,
      "text": "[pausa:10]",
      "file": "c007.ogg",
      "durationSec": 4.536
    },
    {
      "index": 8,
      "text": "Nota l'aria così com'è.",
      "file": "c008.ogg",
      "durationSec": 4.272
    },
    {
      "index": 9,
      "text": "Fredda all'inspirazione.",
      "file": "c009.ogg",
      "durationSec": 4.128
    },
    {
      "index": 10,
      "text": "Calda all'espirazione.",
      "file": "c010.ogg",
      "durationSec": 4.08
    },
    {
      "index": 11,
      "text": "Nessun fumo. Nessun veleno. Solo respiro.",
      "file": "c011.ogg",
      "durationSec": 10.152
    },
    {
      "index": 12,
      "text": "[pausa:12]",
      "file": "c012.ogg",
      "durationSec": 4.584
    },
    {
      "index": 13,
      "text": "Senti il petto espandersi senza sforzo.",
      "file": "c013.ogg",
      "durationSec": 6.0
    },
    {
      "index": 14,
      "text": "Senti le costole allargarsi leggermente.",
      "file": "c014.ogg",
      "durationSec": 5.832
    },
    {
      "index": 15,
      "text": "[pausa:12]",
      "file": "c015.ogg",
      "durationSec": 4.584
    },
    {
      "index": 16,
      "text": "Posa una mano sul cuore, o riposa entrambe le mani in grembo.",
      "file": "c016.ogg",
      "durationSec": 7.896
    },
    {
      "index": 17,
      "text": "Senti un corpo che si sta guarendo.",
      "file": "c017.ogg",
      "durationSec": 5.136
    },
    {
      "index": 18,
      "text": "Polmoni che si liberano. Sangue più libero. Il senso dell'olfatto che torna, giorno dopo giorno.",
      "file": "c018.ogg",
      "durationSec": 14.736
    },
    {
      "index": 19,
      "text": "[pausa:16]",
      "file": "c019.ogg",
      "durationSec": 4.512
    },
    {
      "index": 20,
      "text": "Prova silenziosamente queste frasi, o limitati ad ascoltare.",
      "file": "c020.ogg",
      "durationSec": 8.136
    },
    {
      "index": 21,
      "text": "Il mio respiro appartiene a me.",
      "file": "c021.ogg",
      "durationSec": 4.776
    },
    {
      "index": 22,
      "text": "[pausa:12]",
      "file": "c022.ogg",
      "durationSec": 4.584
    },
    {
      "index": 23,
      "text": "Scelgo aria pulita.",
      "file": "c023.ogg",
      "durationSec": 3.888
    },
    {
      "index": 24,
      "text": "[pausa:12]",
      "file": "c024.ogg",
      "durationSec": 4.584
    },
    {
      "index": 25,
      "text": "Ho finito con quella tossina.",
      "file": "c025.ogg",
      "durationSec": 4.8
    },
    {
      "index": 26,
      "text": "[pausa:14]",
      "file": "c026.ogg",
      "durationSec": 4.944
    },
    {
      "index": 27,
      "text": "Immagina il tuo prossimo momento ordinario senza una sigaretta.",
      "file": "c027.ogg",
      "durationSec": 7.944
    },
    {
      "index": 28,
      "text": "Caffè. Una passeggiata. Una pausa dopo un pasto.",
      "file": "c028.ogg",
      "durationSec": 10.296
    },
    {
      "index": 29,
      "text": "Vedi te stesso completo in quel momento, già libero.",
      "file": "c029.ogg",
      "durationSec": 7.296
    },
    {
      "index": 30,
      "text": "[pausa:22]",
      "file": "c030.ogg",
      "durationSec": 4.44
    },
    {
      "index": 31,
      "text": "Se appare un ricordo di fumo, lascialo essere un'immagine, non un piano.",
      "file": "c031.ogg",
      "durationSec": 9.624
    },
    {
      "index": 32,
      "text": "Torna a questo respiro.",
      "file": "c032.ogg",
      "durationSec": 4.056
    },
    {
      "index": 33,
      "text": "Torna a questo espirare.",
      "file": "c033.ogg",
      "durationSec": 4.104
    },
    {
      "index": 34,
      "text": "[pausa:14]",
      "file": "c034.ogg",
      "durationSec": 4.944
    },
    {
      "index": 35,
      "text": "Respira la libertà.",
      "file": "c035.ogg",
      "durationSec": 3.888
    },
    {
      "index": 36,
      "text": "Espira la vecchia storia dell'abitudine.",
      "file": "c036.ogg",
      "durationSec": 5.712
    },
    {
      "index": 37,
      "text": "[pausa:14]",
      "file": "c037.ogg",
      "durationSec": 4.944
    },
    {
      "index": 38,
      "text": "Hai preso la decisione che conta.",
      "file": "c038.ogg",
      "durationSec": 4.968
    },
    {
      "index": 39,
      "text": "Il tuo corpo sta raggiungendo quella verità.",
      "file": "c039.ogg",
      "durationSec": 5.904
    },
    {
      "index": 40,
      "text": "[pausa:12]",
      "file": "c040.ogg",
      "durationSec": 4.584
    },
    {
      "index": 41,
      "text": "Fai un altro respiro profondo.",
      "file": "c041.ogg",
      "durationSec": 4.968
    },
    {
      "index": 42,
      "text": "E un respiro lungo e facile.",
      "file": "c042.ogg",
      "durationSec": 4.752
    },
    {
      "index": 43,
      "text": "Muovi le dita.",
      "file": "c043.ogg",
      "durationSec": 3.432
    },
    {
      "index": 44,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c044.ogg",
      "durationSec": 5.64
    },
    {
      "index": 45,
      "text": "Porta con te questa aria chiara.",
      "file": "c045.ogg",
      "durationSec": 4.728
    }
  ]
}
