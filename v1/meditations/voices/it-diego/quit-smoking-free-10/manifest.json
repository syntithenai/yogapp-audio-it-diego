{
  "id": "quit-smoking-free-10",
  "voiceId": "it-diego",
  "edgeVoice": "it-IT-DiegoNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 328,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 3.216
    },
    {
      "index": 1,
      "text": "Questa pratica è per te come non fumatore.",
      "file": "c001.ogg",
      "durationSec": 5.568
    },
    {
      "index": 2,
      "text": "Trova una posizione comoda, o sdraiati se ti sembra meglio.",
      "file": "c002.ogg",
      "durationSec": 8.28
    },
    {
      "index": 3,
      "text": "Lascia riposare le mani.",
      "file": "c003.ogg",
      "durationSec": 4.32
    },
    {
      "index": 4,
      "text": "Rilassa gli occhi, o chiudili.",
      "file": "c004.ogg",
      "durationSec": 5.544
    },
    {
      "index": 5,
      "text": "Fai un respiro lento e profondo.",
      "file": "c005.ogg",
      "durationSec": 5.232
    },
    {
      "index": 6,
      "text": "E un respiro più lungo in uscita.",
      "file": "c006.ogg",
      "durationSec": 4.968
    },
    {
      "index": 7,
      "text": "[pausa:16]",
      "file": "c007.ogg",
      "durationSec": 4.512
    },
    {
      "index": 8,
      "text": "Senti il corpo sostenuto.",
      "file": "c008.ogg",
      "durationSec": 4.464
    },
    {
      "index": 9,
      "text": "Niente da dimostrare. Niente da affrettare.",
      "file": "c009.ogg",
      "durationSec": 7.968
    },
    {
      "index": 10,
      "text": "[pausa:16]",
      "file": "c010.ogg",
      "durationSec": 4.512
    },
    {
      "index": 11,
      "text": "Lavoreremo con affermazioni chiare di libertà.",
      "file": "c011.ogg",
      "durationSec": 6.264
    },
    {
      "index": 12,
      "text": "Ascolta, o ripeti silenziosamente ciò che risuona vero.",
      "file": "c012.ogg",
      "durationSec": 7.824
    },
    {
      "index": 13,
      "text": "[pausa:18]",
      "file": "c013.ogg",
      "durationSec": 4.656
    },
    {
      "index": 14,
      "text": "Ora sono un non fumatore.",
      "file": "c014.ogg",
      "durationSec": 4.152
    },
    {
      "index": 15,
      "text": "[pausa:16]",
      "file": "c015.ogg",
      "durationSec": 4.512
    },
    {
      "index": 16,
      "text": "Sono così felice di essermi liberato dalla malattia della nicotina.",
      "file": "c016.ogg",
      "durationSec": 8.352
    },
    {
      "index": 17,
      "text": "[pausa:18]",
      "file": "c017.ogg",
      "durationSec": 4.656
    },
    {
      "index": 18,
      "text": "Fumare non fa più parte della mia vita o della mia identità.",
      "file": "c018.ogg",
      "durationSec": 7.224
    },
    {
      "index": 19,
      "text": "[pausa:18]",
      "file": "c019.ogg",
      "durationSec": 4.656
    },
    {
      "index": 20,
      "text": "Ricevo questi stimoli a causa di ricordi passati o osservando altri fumatori.",
      "file": "c020.ogg",
      "durationSec": 9.504
    },
    {
      "index": 21,
      "text": "[pausa:18]",
      "file": "c021.ogg",
      "durationSec": 4.656
    },
    {
      "index": 22,
      "text": "Questi stimoli non possono farmi nulla, perché mi sono liberato dalla schiavitù della dipendenza.",
      "file": "c022.ogg",
      "durationSec": 10.992
    },
    {
      "index": 23,
      "text": "[pausa:22]",
      "file": "c023.ogg",
      "durationSec": 4.44
    },
    {
      "index": 24,
      "text": "Provo compassione per i fumatori che sono ancora intrappolati nelle loro menzogne sul fumo.",
      "file": "c024.ogg",
      "durationSec": 9.96
    },
    {
      "index": 25,
      "text": "Che sono intrappolati nel miserabile ciclo della depletion di nicotina, dell'impulso e del rifornimento.",
      "file": "c025.ogg",
      "durationSec": 12.168
    },
    {
      "index": 26,
      "text": "[pausa:18]",
      "file": "c026.ogg",
      "durationSec": 4.656
    },
    {
      "index": 27,
      "text": "Non soffro più come loro.",
      "file": "c027.ogg",
      "durationSec": 4.224
    },
    {
      "index": 28,
      "text": "[pausa:14]",
      "file": "c028.ogg",
      "durationSec": 4.944
    },
    {
      "index": 29,
      "text": "Ora conosco la verità.",
      "file": "c029.ogg",
      "durationSec": 3.888
    },
    {
      "index": 30,
      "text": "Non c'è assolutamente nessun beneficio nel fumare.",
      "file": "c030.ogg",
      "durationSec": 6.336
    },
    {
      "index": 31,
      "text": "[pausa:18]",
      "file": "c031.ogg",
      "durationSec": 4.656
    },
    {
      "index": 32,
      "text": "Il test di urina non ha mai aiutato nessuno, e non lo farà mai.",
      "file": "c032.ogg",
      "durationSec": 8.496
    },
    {
      "index": 33,
      "text": "[pausa:18]",
      "file": "c033.ogg",
      "durationSec": 4.656
    },
    {
      "index": 34,
      "text": "Fumare ha creato molti problemi per me.",
      "file": "c034.ogg",
      "durationSec": 5.688
    },
    {
      "index": 35,
      "text": "[pausa:14]",
      "file": "c035.ogg",
      "durationSec": 4.944
    },
    {
      "index": 36,
      "text": "Ho preso la migliore decisione della mia vita: non fumare mai più una boccata di quel disgusto veleno.",
      "file": "c036.ogg",
      "durationSec": 11.544
    },
    {
      "index": 37,
      "text": "Quella decisione era definitiva.",
      "file": "c037.ogg",
      "durationSec": 4.944
    },
    {
      "index": 38,
      "text": "[pausa:22]",
      "file": "c038.ogg",
      "durationSec": 4.44
    },
    {
      "index": 39,
      "text": "Ora, rispetto la Legge del Fumo.",
      "file": "c039.ogg",
      "durationSec": 5.784
    },
    {
      "index": 40,
      "text": "[pausa:18]",
      "file": "c040.ogg",
      "durationSec": 4.656
    },
    {
      "index": 41,
      "text": "Ora, tutte le mie situazioni stanno migliorando.",
      "file": "c041.ogg",
      "durationSec": 7.008
    },
    {
      "index": 42,
      "text": "Sto diventando più felice, più sano e più sicuro di me stesso.",
      "file": "c042.ogg",
      "durationSec": 8.472
    },
    {
      "index": 43,
      "text": "[pausa:22]",
      "file": "c043.ogg",
      "durationSec": 4.44
    },
    {
      "index": 44,
      "text": "Sono libero.",
      "file": "c044.ogg",
      "durationSec": 3.36
    },
    {
      "index": 45,
      "text": "[pausa:28]",
      "file": "c045.ogg",
      "durationSec": 4.584
    },
    {
      "index": 46,
      "text": "Rimani in quella libertà per qualche respiro.",
      "file": "c046.ogg",
      "durationSec": 5.76
    },
    {
      "index": 47,
      "text": "I trigger potrebbero ancora presentarsi come vecchi ricordi.",
      "file": "c047.ogg",
      "durationSec": 7.512
    },
    {
      "index": 48,
      "text": "Non possono riportarti alla schiavitù.",
      "file": "c048.ogg",
      "durationSec": 5.16
    },
    {
      "index": 49,
      "text": "[pausa:36]",
      "file": "c049.ogg",
      "durationSec": 4.488
    },
    {
      "index": 50,
      "text": "Ora sono un non-fumatore.",
      "file": "c050.ogg",
      "durationSec": 4.2
    },
    {
      "index": 51,
      "text": "Sono libero.",
      "file": "c051.ogg",
      "durationSec": 3.36
    },
    {
      "index": 52,
      "text": "[pausa:28]",
      "file": "c052.ogg",
      "durationSec": 4.584
    },
    {
      "index": 53,
      "text": "Fai un altro respiro facile.",
      "file": "c053.ogg",
      "durationSec": 4.872
    },
    {
      "index": 54,
      "text": "Muovi le dita.",
      "file": "c054.ogg",
      "durationSec": 3.432
    },
    {
      "index": 55,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c055.ogg",
      "durationSec": 5.64
    },
    {
      "index": 56,
      "text": "Porta con te questa libertà.",
      "file": "c056.ogg",
      "durationSec": 4.464
    }
  ]
}
