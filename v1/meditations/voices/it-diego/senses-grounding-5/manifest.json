{
  "id": "senses-grounding-5",
  "voiceId": "it-diego",
  "edgeVoice": "it-IT-DiegoNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 157,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 3.216
    },
    {
      "index": 1,
      "text": "Se ti senti disperso o attivato, questa pratica può aiutarti.",
      "file": "c001.ogg",
      "durationSec": 8.112
    },
    {
      "index": 2,
      "text": "Mantieni gli occhi aperti per ora, se ti senti più sicuro così.",
      "file": "c002.ogg",
      "durationSec": 8.424
    },
    {
      "index": 3,
      "text": "Poniti entrambi i piedi a contatto con il pavimento.",
      "file": "c003.ogg",
      "durationSec": 6.864
    },
    {
      "index": 4,
      "text": "[pausa:17]",
      "file": "c004.ogg",
      "durationSec": 4.872
    },
    {
      "index": 5,
      "text": "Nomina cinque cose che puoi vedere.",
      "file": "c005.ogg",
      "durationSec": 5.376
    },
    {
      "index": 6,
      "text": "Con calma. Prenditi tutto il tempo necessario.",
      "file": "c006.ogg",
      "durationSec": 8.376
    },
    {
      "index": 7,
      "text": "[pausa:45]",
      "file": "c007.ogg",
      "durationSec": 4.992
    },
    {
      "index": 8,
      "text": "Nomina quattro cose che puoi sentire o toccare.",
      "file": "c008.ogg",
      "durationSec": 6.456
    },
    {
      "index": 9,
      "text": "Abbigliamento. Sedia. Aria sulla pelle. Piedi sul pavimento.",
      "file": "c009.ogg",
      "durationSec": 13.608
    },
    {
      "index": 10,
      "text": "[pausa:39]",
      "file": "c010.ogg",
      "durationSec": 4.656
    },
    {
      "index": 11,
      "text": "Nomina tre suoni.",
      "file": "c011.ogg",
      "durationSec": 3.84
    },
    {
      "index": 12,
      "text": "Prossimi o lontani. Dolci o chiari.",
      "file": "c012.ogg",
      "durationSec": 7.224
    },
    {
      "index": 13,
      "text": "[pausa:39]",
      "file": "c013.ogg",
      "durationSec": 4.656
    },
    {
      "index": 14,
      "text": "Nomina due odori, oppure semplicemente nota la qualità dell’aria.",
      "file": "c014.ogg",
      "durationSec": 8.592
    },
    {
      "index": 15,
      "text": "[pausa:28]",
      "file": "c015.ogg",
      "durationSec": 4.584
    },
    {
      "index": 16,
      "text": "Nomina un sapore, o il senso che provi in bocca.",
      "file": "c016.ogg",
      "durationSec": 6.912
    },
    {
      "index": 17,
      "text": "[pausa:23]",
      "file": "c017.ogg",
      "durationSec": 4.344
    },
    {
      "index": 18,
      "text": "Sei qui. Nel tuo corpo. In questa stanza.",
      "file": "c018.ogg",
      "durationSec": 9.912
    },
    {
      "index": 19,
      "text": "Inspira per quattro.",
      "file": "c019.ogg",
      "durationSec": 3.888
    },
    {
      "index": 20,
      "text": "Esala per sei.",
      "file": "c020.ogg",
      "durationSec": 3.504
    },
    {
      "index": 21,
      "text": "[pausa:23]",
      "file": "c021.ogg",
      "durationSec": 4.344
    },
    {
      "index": 22,
      "text": "Fai un’altra respirazione facile.",
      "file": "c022.ogg",
      "durationSec": 5.184
    },
    {
      "index": 23,
      "text": "Muovi le dita.",
      "file": "c023.ogg",
      "durationSec": 3.432
    },
    {
      "index": 24,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c024.ogg",
      "durationSec": 5.64
    },
    {
      "index": 25,
      "text": "Porta con te un po’ di questa sensazione.",
      "file": "c025.ogg",
      "durationSec": 5.64
    }
  ]
}
