{
  "id": "body-scan-10",
  "voiceId": "it-diego",
  "edgeVoice": "it-IT-DiegoNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 254,
  "chunks": [
    {
      "index": 0,
      "text": "Benvenuto.",
      "file": "c000.ogg",
      "durationSec": 3.216
    },
    {
      "index": 1,
      "text": "Prenditi il tempo per arrivare.",
      "file": "c001.ogg",
      "durationSec": 4.656
    },
    {
      "index": 2,
      "text": "Siediti o sdraiati con supporto.",
      "file": "c002.ogg",
      "durationSec": 5.448
    },
    {
      "index": 3,
      "text": "Chiudi gli occhi se ti sembra sicuro.",
      "file": "c003.ogg",
      "durationSec": 5.184
    },
    {
      "index": 4,
      "text": "Senti il contatto con il suolo.",
      "file": "c004.ogg",
      "durationSec": 5.04
    },
    {
      "index": 5,
      "text": "Respiro lento in.",
      "file": "c005.ogg",
      "durationSec": 3.696
    },
    {
      "index": 6,
      "text": "Respirazione più lunga in espirazione.",
      "file": "c006.ogg",
      "durationSec": 5.64
    },
    {
      "index": 7,
      "text": "[pausa:21]",
      "file": "c007.ogg",
      "durationSec": 4.488
    },
    {
      "index": 8,
      "text": "Ancora.",
      "file": "c008.ogg",
      "durationSec": 2.976
    },
    {
      "index": 9,
      "text": "[pausa:21]",
      "file": "c009.ogg",
      "durationSec": 4.488
    },
    {
      "index": 10,
      "text": "Lascia che le spalle si abbassino.",
      "file": "c010.ogg",
      "durationSec": 5.04
    },
    {
      "index": 11,
      "text": "Lascia che l'addome si rilassi.",
      "file": "c011.ogg",
      "durationSec": 4.92
    },
    {
      "index": 12,
      "text": "[pausa:27]",
      "file": "c012.ogg",
      "durationSec": 4.776
    },
    {
      "index": 13,
      "text": "Comincia dalla sommità della testa.",
      "file": "c013.ogg",
      "durationSec": 5.064
    },
    {
      "index": 14,
      "text": "Nota la sensazione, o la sua assenza.",
      "file": "c014.ogg",
      "durationSec": 6.336
    },
    {
      "index": 15,
      "text": "[pausa:27]",
      "file": "c015.ogg",
      "durationSec": 4.776
    },
    {
      "index": 16,
      "text": "Fronte. Occhi. Guance. Mascella.",
      "file": "c016.ogg",
      "durationSec": 11.472
    },
    {
      "index": 17,
      "text": "Lascia che il viso si scioglia un po'.",
      "file": "c017.ogg",
      "durationSec": 4.992
    },
    {
      "index": 18,
      "text": "[pausa:27]",
      "file": "c018.ogg",
      "durationSec": 4.776
    },
    {
      "index": 19,
      "text": "Gola. Collo. Spalle.",
      "file": "c019.ogg",
      "durationSec": 8.016
    },
    {
      "index": 20,
      "text": "Invita le spalle ad abbassarsi.",
      "file": "c020.ogg",
      "durationSec": 5.064
    },
    {
      "index": 21,
      "text": "[pausa:32]",
      "file": "c021.ogg",
      "durationSec": 4.536
    },
    {
      "index": 22,
      "text": "Braccia. Gomiti. Polsi. Mani. Dita.",
      "file": "c022.ogg",
      "durationSec": 13.656
    },
    {
      "index": 23,
      "text": "[pausa:32]",
      "file": "c023.ogg",
      "durationSec": 4.536
    },
    {
      "index": 24,
      "text": "Il petto che si alza e si abbassa.",
      "file": "c024.ogg",
      "durationSec": 5.16
    },
    {
      "index": 25,
      "text": "Spazio del cuore morbido.",
      "file": "c025.ogg",
      "durationSec": 4.488
    },
    {
      "index": 26,
      "text": "[pausa:27]",
      "file": "c026.ogg",
      "durationSec": 4.776
    },
    {
      "index": 27,
      "text": "Addome. Bassa schiena. Anca.",
      "file": "c027.ogg",
      "durationSec": 8.808
    },
    {
      "index": 28,
      "text": "[pausa:32]",
      "file": "c028.ogg",
      "durationSec": 4.536
    },
    {
      "index": 29,
      "text": "Cosce. Ginocchia. Polpacci. Caviglie. Piedi. Dita dei piedi.",
      "file": "c029.ogg",
      "durationSec": 17.808
    },
    {
      "index": 30,
      "text": "[pausa:38]",
      "file": "c030.ogg",
      "durationSec": 4.752
    },
    {
      "index": 31,
      "text": "Senti tutto il corpo come un unico campo.",
      "file": "c031.ogg",
      "durationSec": 5.76
    },
    {
      "index": 32,
      "text": "Il respiro che vi si muove attraverso.",
      "file": "c032.ogg",
      "durationSec": 5.688
    },
    {
      "index": 33,
      "text": "[pausa:54]",
      "file": "c033.ogg",
      "durationSec": 5.112
    },
    {
      "index": 34,
      "text": "Se rimane un punto teso, invia un espirazione lì.",
      "file": "c034.ogg",
      "durationSec": 7.296
    },
    {
      "index": 35,
      "text": "[pausa:43]",
      "file": "c035.ogg",
      "durationSec": 4.584
    },
    {
      "index": 36,
      "text": "Rimani in consapevolezza del corpo intero.",
      "file": "c036.ogg",
      "durationSec": 6.0
    },
    {
      "index": 37,
      "text": "[pausa:81]",
      "file": "c037.ogg",
      "durationSec": 4.608
    },
    {
      "index": 38,
      "text": "[pausa:32]",
      "file": "c038.ogg",
      "durationSec": 4.536
    },
    {
      "index": 39,
      "text": "Inizia a approfondire il respiro.",
      "file": "c039.ogg",
      "durationSec": 5.16
    },
    {
      "index": 40,
      "text": "Rivivi la sensazione della stanza.",
      "file": "c040.ogg",
      "durationSec": 5.376
    },
    {
      "index": 41,
      "text": "Muovi le dita delle mani e dei piedi.",
      "file": "c041.ogg",
      "durationSec": 5.424
    },
    {
      "index": 42,
      "text": "Quando sei pronto, apri gli occhi.",
      "file": "c042.ogg",
      "durationSec": 5.64
    },
    {
      "index": 43,
      "text": "Muoviti lentamente verso ciò che segue.",
      "file": "c043.ogg",
      "durationSec": 5.712
    }
  ]
}
